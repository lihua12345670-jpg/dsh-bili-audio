{
    "name":  "dsh-bili-audio",
    "version":  "0.1.0",
    "description":  "DSH 插件：在 Web 界面右下角挂一个 B 站音频播放条 —— 粘贴 BV 号/链接即可听 B 站视频的声音，支持队列、进度、倍速，并由宿主反向代理解决 B 站 CDN 的 Referer 403 问题。",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "README.en.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "engines":  {
                    "node":  "\u003e=20",
                    "dsh":  "\u003e=0.1.0-rc.6 \u003c0.2.0 || \u003e=0.2.0-rc.1 \u003c0.2.1-0 || \u003e=0.2.1-alpha.1 \u003c0.3.0-0"
                },
    "scripts":  {
                    "test":  "node --test tests/*.test.mjs",
                    "smoke":  "node scripts/smoke.mjs"
                },
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "bilibili",
                     "bili",
                     "audio",
                     "player",
                     "music"
                 ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/lihua12345670-jpg/dsh-bili-audio.git"
                   },
    "homepage":  "https://github.com/lihua12345670-jpg/dsh-bili-audio#readme",
    "bugs":  {
                 "url":  "https://github.com/lihua12345670-jpg/dsh-bili-audio/issues"
             },
    "author":  "lihua12345670-jpg"
}